# NanoClaw Environment Configuration
# Copy to .env and fill in values

# --- Assistant identity ---
ASSISTANT_NAME=Butler
ASSISTANT_HAS_OWN_NUMBER=true

# --- Execution mode ---
# "container" = Docker containers (local dev), "direct" = in-process (Railway)
EXECUTION_MODE=direct

# --- Storage ---
# Persistent storage directory (Railway volume mount)
STORE_DIR=/store
# Sender allowlist location (inside persistent storage)
SENDER_ALLOWLIST_PATH=/store/config/sender-allowlist.json

# --- Timezone ---
TZ=America/New_York

# --- API Key ---
# Required for direct execution mode (Railway)
ANTHROPIC_API_KEY=sk-ant-...
